# ElectionIQ — Environment Configuration (India)

# 1. Gemini AI Key
# Get it from: https://aistudio.google.com/
# Enable "Generative Language API"
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps API Key
# Enable "Geocoding API" and "Maps Embed API"
VITE_MAPS_API_KEY=your_maps_api_key_here

# 3. YouTube Data API Key
# Enable "YouTube Data API v3"
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# 4. Google Cloud Text-to-Speech Key
# Enable "Cloud Text-to-Speech API"
VITE_TTS_API_KEY=your_cloud_tts_api_key_here

# 5. Google Cloud Translation Key
# Enable "Cloud Translation API"
VITE_TRANSLATE_API_KEY=your_cloud_translate_api_key_here

# NOTE: If any key is missing or set to the placeholder above, 
# the app will automatically run that feature in "Demo Mode" 
# using realistic Indian mock data.
